local seen = {}
local function log(t, v)
    local s = tostring(v)
    if #s >= 5 and #s <= 500 and not seen[t .. s] then
        seen[t .. s] = true
        print("[" .. t .. "] " .. s)
    end
end
local function spy(n, tp)
    return setmetatable({__tp = tp or "Instance"}, {
        __index = function(_, k)
            log("GET", n .. "." .. tostring(k))
            return spy(n .. "." .. tostring(k), "Instance")
        end,
        __newindex = function(_, k, v) log("SET", n .. "." .. tostring(k) .. "=" .. tostring(v)) end,
        __call = function(_, ...)
            for _, a in ipairs({...}) do log("ARG", a) end
            log("CALL", n)
            return spy(n .. "()", n:match("^([%w_]+)") or "Instance")
        end,
        __tostring = function() return n end,
        __eq = function() return true end,
        __lt = function() return false end,
        __le = function() return true end,
        __add = function() return 0 end,
        __sub = function() return 0 end,
        __mul = function() return 0 end,
        __div = function() return 0 end,
        __concat = function(a, b) local r = tostring(a) .. tostring(b); log("CAT", r); return r end
    })
end
